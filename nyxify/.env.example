# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Database (free tier: Neon or Supabase) ---
DATABASE_URL=postgresql://user:password@localhost:5432/nyxify

# --- Discord OAuth (Discord Developer Portal > OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Discord Bot (same application as OAuth, Bot tab > token) ---
# Used server-side only, in src/lib/discord-bridge.ts, via plain REST calls —
# no separate bot process to host.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_PORTFOLIO_CHANNEL_ID=
# Optional category-specific showcase channels. If any of these are left
# blank, that category's showcases post to DISCORD_PORTFOLIO_CHANNEL_ID
# instead (used as the Clothing/default channel).
DISCORD_CHAINS_CHANNEL_ID=
DISCORD_FACES_CHANNEL_ID=
DISCORD_TATTOOS_CHANNEL_ID=
# Channel where new customer reviews get posted automatically. Optional —
# if left blank, reviews just aren't posted to Discord.
DISCORD_REVIEWS_CHANNEL_ID=
DISCORD_STAFF_ROLE_ID=
# Channel where the live order queue board is posted (an embed that edits
# itself in place as order statuses change). Optional — if left blank, the
# queue board is simply skipped.
DISCORD_QUEUE_CHANNEL_ID=
# Found on your app's "General Information" page in the Developer Portal.
# Needed to verify that slash-command requests (like /deliver) really came
# from Discord.
DISCORD_PUBLIC_KEY=

# --- PayPal (developer.paypal.com) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Same client ID, exposed to the browser for the PayPal Buttons widget
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Cash App Pay, processed via Square (squareup.com/signup + Square Developer Dashboard) ---
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox
# Exposed to the browser for the Cash App Pay widget
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENV=sandbox

# --- File Storage: Cloudflare R2 or Supabase Storage, both free-tier and both S3-compatible ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=nyxify-vault
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
